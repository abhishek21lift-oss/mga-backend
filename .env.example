# 619 Fitness ERP — backend env template
# Copy to .env and fill in real values. NEVER commit .env (it's in .gitignore).

# ── Server ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Queue infrastructure (BullMQ + Redis) ──────────────────────────
# Redis backs the background job queues (email, whatsapp, AI ingestion,
# notification fan-out, membership renewals). It is OPTIONAL: when unset,
# every producer degrades to its pre-queue inline path (e.g. SMTP sends
# run synchronously, document ingestion runs fire-and-forget in-process),
# so the app boots and works without it — just without retries/backoff or
# off-request-path processing. Set it to get real background delivery.
#
# Local dev: spin up Redis with  docker run -d -p 6379:6379 redis:7
# REDIS_URL=redis://localhost:6379
# Managed TLS (Upstash/Render):  REDIS_URL=rediss://user:pass@host:port
# Or the parts individually (REDIS_URL wins when both are set):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=0

# Runs the BullMQ workers INSIDE the API process (single-instance deploys
# like Render free tier). Set to "0" to run workers separately — e.g. a
# second service running `npm run worker:all` — so each process does not
# double-drain every queue.
# RUN_WORKERS=1

# Shared queue policy. Attempts are bounded with exponential backoff, so a
# flaky SMTP/WhatsApp provider is retried 2s, 4s, 8s before the job fails.
# BULL_ATTEMPTS=3
# BULL_BACKOFF_DELAY_MS=2000
# BULL_PREFIX=bull
# How many recent jobs to keep for the super-admin queue dashboard.
# BULL_KEEP_COMPLETE=1000
# BULL_KEEP_FAILED=5000

# Renewal scheduling (membership expiry reminders + auto-renew). Defaults:
# daily at 03:00 server time, class reminders every 30 minutes.
# RENEWAL_CRON=0 3 * * *
# RENEWAL_CLASS_CRON=*/30 * * * *

# Per-queue worker concurrency (in-process workers). Keep the AI worker low —
# local embedding inference is CPU-bound and shares the process with requests.
# EMAIL_WORKER_CONCURRENCY=5
# WHATSAPP_WORKER_CONCURRENCY=5
# NOTIFICATIONS_WORKER_CONCURRENCY=5
# AI_WORKER_CONCURRENCY=2

# ── Database ───────────────────────────────────────────────────────
# Supabase pooler URI from Supabase → Settings → Database → Connection string → URI
# The pool uses ssl: { rejectUnauthorized: false } to accept Supabase's
# SNI cert. For higher assurance set DATABASE_SSL_CA to the Supabase root
# CA bundle and the pool will switch to verify-full.
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-db-password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_SSL_CA=/etc/secrets/supabase-ca.pem  ← optional: full cert chain verification
# In production without DATABASE_SSL_CA the pool uses the system CA store (trusts
# Render / Supabase signed certs). rejectUnauthorized:false is only used in dev.
# DATABASE_POOL_SIZE=10

# ── Auth ───────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 chars or the server refuses to boot.
JWT_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
# Short-lived access token (15m recommended). Paired with a 7-day refresh token.
JWT_EXPIRES_IN=15m

# ── Migration vs application database role ─────────────────────────
# DATABASE_URL is the connection the application serves traffic on. Once
# tenant isolation is enforced it should point at `app_tenant`, which is
# deliberately NOSUPERUSER, NOBYPASSRLS and has no CREATE on schema public:
# a runtime role that can reshape the schema has a far larger blast radius
# than one that can only read and write rows.
#
# Migrations need exactly the DDL rights that role lacks. Set
# MIGRATION_DATABASE_URL to a privileged role and migrations use it; leave it
# unset and they fall back to DATABASE_URL, which is what every deployment
# does today. Without the split, pointing DATABASE_URL at app_tenant stops the
# server booting: "permission denied for schema public".
# MIGRATION_DATABASE_URL=postgresql://<privileged-role>:<password>@host:6543/postgres

# Off by default. Turning it on makes db/pool.js set app.org_id per request so
# PostgreSQL RLS policies resolve. Only meaningful once DATABASE_URL points at
# a role that cannot bypass RLS — see src/db/migrations/TENANT-RLS-PLAN.md.
# TENANT_RLS_ENFORCE=on

# ── Product identity ───────────────────────────────────────────────
# Used by the transactional email templates (invitation, client
# activation) for the wordmark, subject lines and footer. See
# src/lib/siteIdentity.js.
#
# SITE_NAME is optional and falls back to "MY PT STUDIO" — getting it
# wrong is cosmetic.
#
# SUPPORT_EMAIL has NO fallback, on purpose. Unset, the support line is
# omitted from outbound mail entirely. That is deliberate: a missing
# contact address is a bug somebody reports, whereas a plausible but
# wrong one sends real people to a company that cannot help them and
# will never know why they are writing. Any deployment that is not the
# original product MUST set both.
# SITE_NAME=Your Product Name
# SUPPORT_EMAIL=support@your-domain.com

# ── CORS / Frontend origin ─────────────────────────────────────────
FRONTEND_URL=https://619-erp-frontend.vercel.app
# Comma-separated list of allowed origins (overrides FRONTEND_URL)
# CORS_ORIGIN=https://your-app.vercel.app,https://staging.your-app.vercel.app

# ── Email (SMTP) ───────────────────────────────────────────────────
# Required for password resets AND for admin invitations. With these
# unset, creating a studio on the invitation path is REFUSED (a studio
# whose owner can never be emailed a link is an account nobody can
# claim) — set a password explicitly to create one without email.
#
# Hostinger:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465            # 465 uses implicit TLS; 587 uses STARTTLS
# SMTP_USER=support@myptstudio.com
# SMTP_PASS=<the mailbox password>
# SMTP_FROM=support@myptstudio.com

# The From address on admin invitations specifically. Invitations are the
# one message a recipient is asked to TRUST, so they come from an address
# that can be replied to rather than a noreply. Falls back to SMTP_FROM.
# EMAIL_FROM=support@myptstudio.com

# How many times to retry a failed send. Only transient failures (4xx and
# connection errors) are retried — retrying a rejected recipient is just
# extra bounces against the sending domain's reputation.
# SMTP_SEND_ATTEMPTS=3

# ── Admin invitations ──────────────────────────────────────────────
# How long an invitation link stays valid. Defaults to 24.
# INVITE_EXPIRY_HOURS=24
# Invitations allowed per account per hour. Defaults to 3.
# INVITE_RATE_LIMIT=3

# The API's OWN public URL — where a machine fetches, as opposed to
# FRONTEND_URL which is where a person clicks. Used to build the absolute
# URL of the invitation email's open-tracking pixel. On Render this is
# injected automatically as RENDER_EXTERNAL_URL and needs no setting; set
# it explicitly elsewhere. When neither resolves to a public host the
# email simply ships without a pixel rather than with a broken image.
# PUBLIC_API_URL=https://api.myptstudio.com

# ── Branch (multi-branch deployments) ──────────────────────────────
# Set to the branch ID for this deployment. Defaults to 'br-main'.
# BRANCH_ID=br-main

# ── Google OAuth (Sign-In + Calendar) ──────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorised JavaScript origins: https://your-frontend.vercel.app
# Authorised redirect URIs: https://your-api.onrender.com/api/calendar/callback
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
# Full URL of this backend's /api/calendar/callback endpoint (must match Google Console)
GOOGLE_CALENDAR_REDIRECT_URI=https://your-api.onrender.com/api/calendar/callback

# ── AI — OpenRouter Multi-Model Gateway ────────────────────────────
# Get your API key at https://openrouter.ai
# Without OPENROUTER_API_KEY, /api/ai/* routes return 501 (not configured).
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Model IDs served via OpenRouter — change without redeploying. OpenRouter's
# catalogue includes OpenAI, Anthropic (Claude), Google (Gemini), DeepSeek,
# Qwen, Gemma, and GPT-OSS models, so switching provider/model is just
# changing these strings — see https://openrouter.ai/models for IDs.
# Primary:   fitness coaching, workout & diet generation, progress analysis
AI_PRIMARY_MODEL=openai/gpt-oss-120b:free
# Secondary: code generation, SQL, technical analysis, debugging
AI_SECONDARY_MODEL=poolside/laguna-m.1:free
# Fallback:  automatic failover, reports, summaries, business insights
AI_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── AI Knowledge Base / RAG (SOPs, guides, policies) ────────────────
# Embedding provider for the AI Coach's document retrieval. "local" (default)
# runs @xenova/transformers fully offline/free — no API key, but it downloads
# ~90MB of model weights from huggingface.co on first use. If your deploy
# target blocks that host, or the network silently drops the connection
# instead of refusing it, indexing times out and the document shows
# status='failed' with a clear error (see AI_EMBEDDING_LOAD_TIMEOUT_MS)
# rather than sitting at 'processing' forever; no other provider is
# implemented yet.
# AI_EMBEDDING_PROVIDER=local
# AI_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Directory to cache downloaded embedding model weights. Defaults to the
# library's own OS cache path if unset.
# AI_EMBEDDING_CACHE_DIR=/tmp/ai-embeddings-cache
# Set to "off" to skip embedding the model at server boot (it will instead
# download lazily on the first document upload / chat message).
# AI_EMBEDDING_WARMUP=off
# How long to wait for the embedding model to finish downloading/loading
# before giving up (ms). Raise this if your connection to huggingface.co is
# just slow rather than blocked — check server logs for "AI embedding model
# warmup failed" / "ai_knowledge_ingest_failed" to tell the two apart.
# AI_EMBEDDING_LOAD_TIMEOUT_MS=120000
# How long a single chunk's embedding inference may take before giving up.
# AI_EMBEDDING_TIMEOUT_MS=30000

# Chunking + retrieval tuning — safe to leave at defaults.
# AI_RAG_CHUNK_SIZE=800
# AI_RAG_CHUNK_OVERLAP=150
# AI_RAG_TOP_K=5
# AI_RAG_SIMILARITY_THRESHOLD=0.55

# ── Razorpay (H-06) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_<your-key-id>
RAZORPAY_KEY_SECRET=<your-key-secret>
# Webhook secret from Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# ── Admin bootstrap (src/db/seed.js — run once against a fresh DB) ──
# node src/db/seed.js reads these to create the single initial admin
# account. Not read at server boot; only needed when seeding.
ADMIN_EMAIL=<you@example.com>
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=Admin

# ── WebAuthn / Passkeys (auth-webauthn.js, webauthn.js) ─────────────
# RP_ID must be the bare domain (no scheme/port) the frontend is served
# from; WEBAUTHN_ORIGIN is the full origin(s), comma-separated if you
# serve from more than one (e.g. web + Capacitor). Also referenced by
# render.yaml for the vendor's own deployment — override per client.
RP_ID=your-domain.com
RP_NAME=619 Fitness
WEBAUTHN_ORIGIN=https://your-domain.com

# ── Sentry (error monitoring) ────────────────────────────────────────
# Optional — Sentry is a no-op until SENTRY_DSN is set.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Logging ───────────────────────────────────────────────────────────
# pino log level. Defaults to 'info' in production, 'debug' otherwise.
# LOG_LEVEL=info

# ── Email (Resend — preferred over SMTP when set) ────────────────────
# EMAIL_FROM=no-reply@your-domain.com
# RESEND_API_KEY=<your-resend-api-key>

# ── WhatsApp / SMS (Twilio) ───────────────────────────────────────────
# TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
# TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SMS_FROM=+1XXXXXXXXXX

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────
# FCM_SERVER_KEY=<your-fcm-server-key>

# ── Cloudflare R2 (large file storage) ────────────────────────────────
# REQUIRED IN PRODUCTION. Without these, uploaded avatars/documents and
# generated PDFs fall back to local disk — and Render's filesystem is
# ephemeral, so every consent PDF and PAR-Q form is destroyed on the next
# deploy or restart. The server now refuses to boot in production when R2
# is unconfigured, and refuses to boot in ANY environment when it is only
# partially configured (all three values, or none).
# Leave all three unset for local development to use disk on purpose.
# Generate an API token: Cloudflare dashboard → R2 → Manage API Tokens.
# R2_ACCOUNT_ID=<your-cloudflare-account-id>
# R2_ACCESS_KEY_ID=<your-r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# R2_BUCKET=client-files

# ── Reverse-proxy hops in front of this process ───────────────────────
# Number of proxies between the client and Express, used for req.ip and
# therefore for every rate limiter. Render alone = 1 (the default);
# Cloudflare in front of Render = 2. Setting this too low buckets all
# callers into one rate-limit key and weakens login brute-force defence.
# Verify by logging req.ip in production against real client addresses.
# TRUST_PROXY=1

# ── Keepalive (free-tier sleep prevention) ────────────────────────────
# Render spins a free service down after 15 minutes without INBOUND
# traffic, and the next visitor waits out a cold start (which here also
# includes loading the local embedding model). The server pings itself
# every 14 minutes to stay awake — but the ping must leave the container
# and come back through Render's router to count, so it targets the
# service's own PUBLIC url. Render injects RENDER_EXTERNAL_URL
# automatically, so on Render there is nothing to set.
# KEEPALIVE_URL is only for hosting that does not provide it.
# KEEPALIVE_URL=https://your-api.example.com/api/health
#
# The window matters for cost, not politeness: the free tier includes 750
# instance-hours a month and staying awake 24/7 burns ~730 of them, so a
# second free service on the account takes the account over and everything
# stops. Pinging only during studio hours costs ~550 and leaves the night
# to sleep. Hours are 0-23 in KEEPALIVE_TZ; end is exclusive; a window may
# wrap past midnight (22 → 6); start == end means always on.
# KEEPALIVE_START_HOUR=5
# KEEPALIVE_END_HOUR=23
# KEEPALIVE_TZ=Asia/Kolkata

# ── Command Center realtime stream (Phase 3) ──────────────────────────
# The operator console upgrades from a 5s poll to a WebSocket at
# /api/command-center/stream. It needs nothing set: the defaults below are
# what production runs on, and if the socket cannot be opened — nginx
# without the Upgrade block, a proxy that strips WebSockets — the console
# falls back to polling on its own and says so on screen.
#
# Turn the stream off entirely. The console keeps working, at 5s.
# COMMAND_CENTER_STREAM=off
#
# How often a snapshot is pushed while somebody is watching. There is ONE
# loop per process, shared by every connected operator, and it does not run
# at all when nobody is connected — so this is the cost of an OPEN console,
# not a permanent background load. Each collector still has its own TTL
# (see modules/command-center/index.js), so a 1s tick does not mean the
# database is probed every second.
# COMMAND_CENTER_STREAM_MS=1000
#
# How long the single-use handshake ticket stays redeemable. Long enough
# for one page load; short because the ticket travels in a query string and
# therefore lands in nginx's access log.
# COMMAND_CENTER_TICKET_TTL_MS=30000

# ── Tier 3: platform role (migration 163) ────────────────────────────────
# app_platform, used ONLY by super-admin routes. Separate credential from
# DATABASE_URL: a platform request has no organisation, so app_tenant's
# RLS policies can never match it. Set with:
#   scripts/provision-app-platform-password.js
# Never falls back to DATABASE_URL in production — see src/db/platformPool.js.
PLATFORM_DATABASE_URL=postgresql://app_platform:REPLACE_ME@host:5432/postgres
PLATFORM_DB_POOL_MAX=5
